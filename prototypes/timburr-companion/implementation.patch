+import type { GameModel } from '../game/model';
+import type { TurnState } from '../game/turns';
+
+export type CompanionMood = 'welcome' | 'build' | 'connect' | 'load' | 'draw' | 'inspect' | 'thinking' | 'concern' | 'uncertain' | 'repair' | 'celebrate' | 'foreman';
+export interface CompanionCue { mood: CompanionMood; text: string }
+export const WELCOME: CompanionCue = { mood: 'welcome', text: 'Timburr reporting for duty. Let’s build something brilliant.' };
+export const FOREMAN_DEMO: CompanionCue = { mood: 'foreman', text: 'Foreman mode! Same friend. Much bigger building standards. (Just a preview.)' };
+
+/** Presentation reads real transitions; it never changes rules or diagnoses physics. */
+export function transitionCue(
+  before: { model: GameModel; turn: TurnState | null; tool: string; mode: string },
+  after: { model: GameModel; turn: TurnState | null; tool: string; mode: string },
+): CompanionCue | null {
+  if (before.mode !== after.mode) return { mood: 'welcome', text: 'New job site! I’ve brought my timber. You bring the ideas.' };
+  const turn = after.turn;
+  if (turn && turn !== before.turn) {
+    const report = turn.reports.at(-1), previous = before.turn?.reports.at(-1);
+    if (report && report !== previous) {
+      if (turn.finished) return { mood: 'celebrate', text: 'That’s a wrap on this playtest! Final results are in the turn details.' };
+      if (report.status === 'unresolved') return { mood: 'uncertain', text: 'The experimental check is unresolved. Let’s inspect it before drawing conclusions.' };
+      if (report.status === 'unstable') {
+        // Only a committed stable-to-unstable change gets the rare costume gag.
+        // Both reports are experimental: this is not a verified failure or penalty.
+        return previous?.status === 'stable'
+          ? { mood: 'foreman', text: 'FOREMAN MODE! The experimental check changed to unstable. Let’s inspect those connections—no collapse or penalty assumed.' }
+          : { mood: 'concern', text: 'The experimental check flags instability. Let’s look at the connections together.' };
+      }
+      if (report.status === 'partial') return { mood: 'concern', text: 'Some pieces are floating. Only the supported part has experimental results.' };
+      if (previous && previous.status !== 'stable') return { mood: 'repair', text: 'Looking better! The experimental check now converges. Nice teamwork.' };
+      return { mood: 'draw', text: 'Turn recorded. New cards, new possibilities! Let’s see what we can build.' };
+    }
+    if (turn.draft.connections.length > (before.turn?.draft.connections.length ?? 0))
+      return { mood: 'connect', text: 'Click! One end connected. Each end gets its own connection.' };
+    if (turn.draft.loads.length > (before.turn?.draft.loads.length ?? 0))
+      return { mood: 'load', text: 'A little more responsibility. Follow that load all the way to a foundation.' };
+    if (turn.draft.members.length > (before.turn?.draft.members.length ?? 0))
+      return { mood: 'build', text: 'A fine new piece! Remember: touching a joint isn’t the same as connecting to it.' };
+  }
+  if (after.model !== before.model && !turn) {
+    if (after.model.members.length > before.model.members.length) return { mood: 'build', text: 'Timber! Well… sometimes steel. Either way, lovely building.' };
+    if (after.model.members.length < before.model.members.length) return { mood: 'inspect', text: 'Making room for a better idea. Keep an eye on the remaining load path.' };
+    const keys = Object.keys(after.model.attrs);
+    if (keys.some(key => (after.model.attrs[key]?.load ?? 0) > (before.model.attrs[key]?.load ?? 0)))
+      return { mood: 'load', text: 'Load incoming! A strong foundation loves a clear path.' };
+    if (keys.some(key => after.model.attrs[key]?.joint && !before.model.attrs[key]?.joint))
+      return { mood: 'connect', text: 'That joint has some backbone now. Ready to inspect its degrees of freedom?' };
+  }
+  if (after.tool !== before.tool && ['joint', 'load', 'inspect'].includes(after.tool))
+    return { mood: 'inspect', text: after.tool === 'load' ? 'Where should this weight go? Pick a joint and mind its load path.' : 'Measure twice, connect once. Let’s take a closer look.' };
+  return null;
+}
+
+/** Manual simulation stays experimental; it never triggers the angry transformation. */
+export function analysisCue(result: { error?: string; mechanism: boolean; floating: string[]; designChecksAvailable?: boolean; failing?: number; success?: boolean }): CompanionCue {
+  if (result.error) return { mood: 'uncertain', text: 'No usable result yet. Check the analysis message; we haven’t proved anything about safety.' };
+  if (result.mechanism) return { mood: 'concern', text: 'The experimental check flags a mechanism. A brace or connection may help—let’s inspect it.' };
+  if (result.floating.length) return { mood: 'concern', text: 'Some pieces are floating. Those parts don’t have valid force results.' };
+  if (result.designChecksAvailable !== false && (result.failing ?? 0) > 0) return { mood: 'concern', text: 'The experimental design check flags overload. Let’s inspect the highlighted members.' };
+  return result.success
+    ? { mood: 'celebrate', text: 'Nice work! The current experimental objective checks passed. That deserves a little timber dance.' }
+    : { mood: 'inspect', text: 'Results are ready. Let’s inspect the experimental reactions and load paths.' };
+}
