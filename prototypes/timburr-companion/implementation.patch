+import { describe, expect, it } from 'vitest';
+import { analysisCue, transitionCue } from './cues';
+import { createTurnGame, endTurn, projectTurnModel, type TurnState } from '../game/turns';
+
+function commit(state: TurnState, status: 'stable' | 'unstable' | 'unresolved' | 'partial') {
+  const result = endTurn(state, state.turn, status);
+  if (!result.ok) throw new Error(result.reason);
+  return result.state;
+}
+const snapshot = (turn: TurnState) => ({ turn, model: projectTurnModel(turn), mode: 'multiplayer', tool: 'shs' });
+
+describe('companion result semantics', () => {
+  it('reserves automatic Conkeldurr for a newly committed stable-to-unstable change without mutating the turn', () => {
+    const stable = commit(createTurnGame(), 'stable');
+    const unstable = commit(stable, 'unstable');
+    const original = JSON.stringify(unstable);
+    expect(transitionCue(snapshot(stable), snapshot(unstable))).toMatchObject({ mood: 'foreman' });
+    expect(transitionCue(snapshot(stable), snapshot(unstable))?.text).toContain('experimental');
+    expect(JSON.stringify(unstable)).toBe(original);
+    expect(unstable.reports.at(-1)?.penalty).toBe(0);
+    const repeated = commit(unstable, 'unstable');
+    expect(transitionCue(snapshot(unstable), snapshot(repeated))?.mood).toBe('concern');
+  });
+  it('does not infer failure from an unknown baseline, a partial component or a solver error', () => {
+    const initial = createTurnGame();
+    const unstable = commit(initial, 'unstable');
+    expect(transitionCue(snapshot(initial), snapshot(unstable))?.mood).toBe('concern');
+    const partial = commit(initial, 'partial');
+    expect(transitionCue(snapshot(initial), snapshot(partial))?.mood).toBe('concern');
+    const stable = commit(initial, 'stable');
+    const unknown = commit(stable, 'unresolved');
+    expect(transitionCue(snapshot(stable), snapshot(unknown))?.mood).toBe('uncertain');
+    expect(analysisCue({ error: 'Timed out', mechanism: true, floating: [] }).mood).toBe('uncertain');
+    expect(analysisCue({ mechanism: true, floating: [] }).mood).toBe('concern');
+  });
+  it('does not replay committed results when inspecting or staging the same turn', () => {
+    const turn = commit(createTurnGame(), 'unstable');
+    expect(transitionCue(snapshot(turn), snapshot({ ...turn }))).toBeNull();
+  });
+  it('celebrates repair without claiming verified safety or victory', () => {
+    const unstable = commit(createTurnGame(), 'unstable');
+    const repaired = commit(unstable, 'stable');
+    const cue = transitionCue(snapshot(unstable), snapshot(repaired));
+    expect(cue?.mood).toBe('repair');
+    expect(cue?.text).toContain('experimental');
+    expect(analysisCue({ mechanism: false, floating: [], success: false }).mood).toBe('inspect');
+  });
+});
