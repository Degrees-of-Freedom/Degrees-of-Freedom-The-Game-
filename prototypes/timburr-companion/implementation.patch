+import { create } from 'zustand';
+import { WELCOME, type CompanionCue } from './cues';
+
+interface CompanionState {
+  cue: CompanionCue;
+  sequence: number;
+  lastForeman: number;
+  react: (cue: CompanionCue) => void;
+}
+
+/** One replaceable reaction, never a queue. Repeated solver results cannot spam spectacle. */
+export const useCompanion = create<CompanionState>((set, get) => ({
+  cue: WELCOME,
+  sequence: 0,
+  lastForeman: -Infinity,
+  react(cue) {
+    const current = get(), now = performance.now();
+    if (current.cue.text === cue.text && now - lastReaction < 2500) return;
+    if (cue.mood === 'foreman' && now - current.lastForeman < 45000) {
+      cue = { mood: 'concern', text: 'Let’s inspect those connections. The experimental check needs attention.' };
+    } else if (cue.mood === 'foreman') {
+      set({ lastForeman: now });
+    }
+    // Routine build chatter must not immediately overwrite an important result.
+    if (now - lastReaction < 3500 && ['foreman', 'concern', 'uncertain', 'repair'].includes(current.cue.mood)
+      && ['build', 'connect', 'load', 'inspect', 'draw'].includes(cue.mood)) return;
+    lastReaction = now;
+    set({ cue, sequence: current.sequence + 1 });
+  },
+}));
+let lastReaction = -Infinity;
