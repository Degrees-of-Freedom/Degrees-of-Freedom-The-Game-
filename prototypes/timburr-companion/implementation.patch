+import { useEffect, useRef } from 'react';
+import type { CompanionMood } from './cues';
+
+/** Quiet original synth accents; user input must unlock sound, never a page load. */
+export function useCompanionSound(enabled: boolean, mood: CompanionMood, sequence: number) {
+  const audio = useRef<AudioContext | null>(null);
+  const lastSequence = useRef(sequence);
+  useEffect(() => {
+    if (!enabled) { void audio.current?.close(); audio.current = null; return; }
+    const unlock = () => {
+      try { audio.current ??= new AudioContext(); void audio.current.resume().catch(() => {}); }
+      catch { /* Visual feedback remains available without audio support. */ }
+    };
+    window.addEventListener('pointerdown', unlock);
+    window.addEventListener('keydown', unlock);
+    return () => {
+      window.removeEventListener('pointerdown', unlock);
+      window.removeEventListener('keydown', unlock);
+      void audio.current?.close();
+      audio.current = null;
+    };
+  }, [enabled]);
+  useEffect(() => {
+    if (lastSequence.current === sequence) return;
+    lastSequence.current = sequence;
+    const context = audio.current;
+    if (!enabled || !context || context.state !== 'running' || document.hidden) return;
+    const notes = mood === 'foreman' ? [130, 98] : mood === 'celebrate' || mood === 'repair' ? [523, 659, 784] : [330, 440];
+    notes.forEach((frequency, index) => {
+      const oscillator = context.createOscillator(), gain = context.createGain();
+      const start = context.currentTime + index * 0.075;
+      oscillator.type = mood === 'foreman' ? 'triangle' : 'sine';
+      oscillator.frequency.value = frequency;
+      gain.gain.setValueAtTime(0, start);
+      gain.gain.linearRampToValueAtTime(0.025, start + 0.012);
+      gain.gain.exponentialRampToValueAtTime(0.001, start + 0.15);
+      oscillator.connect(gain);
+      gain.connect(context.destination);
+      oscillator.start(start);
+      oscillator.stop(start + 0.17);
+      oscillator.onended = () => { oscillator.disconnect(); gain.disconnect(); };
+    });
+  }, [enabled, mood, sequence]);
+}
