diff --git a/apps/web/src/companion/AvatarStage.tsx b/apps/web/src/companion/AvatarStage.tsx
new file mode 100644
index 0000000..41f11d6
--- /dev/null
+++ b/apps/web/src/companion/AvatarStage.tsx
@@ -0,0 +1,141 @@
+import { useEffect, useRef, useState } from 'react';
+import * as THREE from 'three';
+import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
+import { DRACOLoader } from 'three/addons/loaders/DRACOLoader.js';
+import type { CompanionMood } from './cues';
+
+interface Props { mood: CompanionMood; sequence: number; reduced: boolean }
+function disposeObject(object: THREE.Object3D) {
+  const textures = new Set<THREE.Texture>();
+  object.traverse(child => {
+    if (!(child instanceof THREE.Mesh)) return;
+    child.geometry.dispose();
+    const materials = Array.isArray(child.material) ? child.material : [child.material];
+    for (const material of materials) {
+      for (const value of Object.values(material)) if (value instanceof THREE.Texture) textures.add(value);
+      material.dispose();
+    }
+  });
+  for (const texture of textures) texture.dispose();
+}
+
+/** Local static GLBs with procedural whole-character motion (no skeletal clips). */
+export function AvatarStage(props: Props) {
+  const host = useRef<HTMLDivElement>(null);
+  const state = useRef(props);
+  const [failed, setFailed] = useState(false);
+  const [loading, setLoading] = useState(true);
+  useEffect(() => { state.current = props; }, [props]);
+  useEffect(() => {
+    const element = host.current;
+    if (!element) return;
+    let renderer: THREE.WebGLRenderer;
+    try { renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: 'low-power' }); }
+    catch { setFailed(true); setLoading(false); return; }
+    setFailed(false);
+    setLoading(true);
+    renderer.setPixelRatio(Math.min(devicePixelRatio, 1.5));
+    renderer.setSize(180, 180);
+    renderer.setClearColor(0x000000, 0);
+    renderer.outputColorSpace = THREE.SRGBColorSpace;
+    renderer.toneMapping = THREE.ACESFilmicToneMapping;
+    renderer.toneMappingExposure = 1.25;
+    element.appendChild(renderer.domElement);
+    const scene = new THREE.Scene();
+    const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 30);
+    camera.position.set(0, 1.65, 6.8);
+    camera.lookAt(0, 1.2, 0);
+    scene.add(new THREE.HemisphereLight(0xfff5df, 0x74648c, 3));
+    const key = new THREE.DirectionalLight(0xffedcf, 4);
+    key.position.set(3, 5, 5);
+    scene.add(key);
+    const fill = new THREE.DirectionalLight(0xb8e5f0, 2);
+    fill.position.set(-4, 2, -2);
+    scene.add(fill);
+    const stage = new THREE.Group();
+    scene.add(stage);
+    const shadow = new THREE.Mesh(new THREE.CircleGeometry(1.05, 40), new THREE.MeshBasicMaterial({ color: 0x5e3e40, transparent: true, opacity: 0.13, depthWrite: false }));
+    shadow.rotation.x = -Math.PI / 2;
+    shadow.position.y = -0.02;
+    scene.add(shadow);
+    const draco = new DRACOLoader().setDecoderPath(`${import.meta.env.BASE_URL}companion/draco/`);
+    const loader = new GLTFLoader().setDRACOLoader(draco);
+    const models = new Map<string, THREE.Group>();
+    const requested = new Set<string>();
+    let disposed = false, frame = 0, lastFrame = 0, active = '', started = performance.now(), sequence = -1;
+    function load(name: string) {
+      if (requested.has(name)) return;
+      requested.add(name);
+      loader.load(`${import.meta.env.BASE_URL}companion/${name}.glb`, gltf => {
+        if (disposed) { disposeObject(gltf.scene); return; }
+        const box = new THREE.Box3().setFromObject(gltf.scene);
+        const size = box.getSize(new THREE.Vector3());
+        const center = box.getCenter(new THREE.Vector3());
+        const scale = Math.min(2.5 / size.y, 3.25 / size.x, 2.6 / size.z);
+        gltf.scene.position.set(-center.x * scale, -box.min.y * scale, -center.z * scale);
+        gltf.scene.scale.setScalar(scale);
+        const wrapper = new THREE.Group();
+        wrapper.add(gltf.scene);
+        wrapper.visible = false;
+        stage.add(wrapper);
+        models.set(name, wrapper);
+        setLoading(false);
+      }, undefined, error => {
+        if (disposed) return;
+        // Never substitute the wrong character during a failed transformation.
+        console.warn("Companion model could not load; using its portrait.", error);
+        setFailed(true);
+        setLoading(false);
+      });
+    }
+    load('timburr');
+    const lost = (event: Event) => {
+      event.preventDefault();
+      setFailed(true);
+      cancelAnimationFrame(frame);
+    };
+    renderer.domElement.addEventListener('webglcontextlost', lost);
+    function render(now: number) {
+      if (disposed) return;
+      frame = requestAnimationFrame(render);
+      if (document.hidden || now - lastFrame < 32) return;
+      lastFrame = now;
+      const current = state.current;
+      if (sequence !== current.sequence) { sequence = current.sequence; started = now; }
+      const desired = current.mood === 'foreman' ? 'conkeldurr' : 'timburr';
+      load(desired);
+      if (models.has(desired)) {
+        if (active !== desired) {
+          for (const [name, model] of models) model.visible = name === desired;
+          active = desired;
+          started = now;
+        }
+        const elapsed = Math.min((now - started) / 1000, 20);
+        const moving = !current.reduced;
+        const bounce = moving && ['build', 'connect', 'draw', 'repair', 'celebrate', 'welcome'].includes(current.mood)
+          ? Math.abs(Math.sin(elapsed * 7)) * Math.exp(-elapsed * 1.3) * 0.24 : 0;
+        stage.position.y = moving ? Math.sin(now / 950) * 0.025 + bounce : 0;
+        stage.rotation.y = -0.16 + (moving ? Math.sin(now / 2100) * 0.09 : 0);
+        stage.rotation.z = moving && current.mood === 'concern' ? Math.sin(elapsed * 6) * Math.exp(-elapsed) * 0.09 : 0;
+        if (moving && current.mood === 'foreman') stage.rotation.z = Math.sin(elapsed * 14) * Math.exp(-elapsed * 1.8) * 0.055;
+        if (moving && current.mood === 'celebrate') stage.rotation.y += Math.sin(elapsed * 5) * Math.exp(-elapsed * 0.6) * 0.4;
+        shadow.scale.setScalar(1 - bounce * 0.45);
+      }
+      renderer.render(scene, camera);
+    }
+    frame = requestAnimationFrame(render);
+    return () => {
+      disposed = true;
+      cancelAnimationFrame(frame);
+      renderer.domElement.removeEventListener('webglcontextlost', lost);
+      disposeObject(scene);
+      draco.dispose();
+      renderer.dispose();
+      renderer.domElement.remove();
+    };
+  }, []);
+  return <div className="companion-stage">
+    <div ref={host} aria-hidden="true" style={{ visibility: failed || loading ? "hidden" : "visible" }} />
+    {(failed || loading) && <img key={props.mood === "foreman" ? "conkeldurr" : "timburr"} className="companion-portrait" src={`${import.meta.env.BASE_URL}companion/${props.mood === "foreman" ? "conkeldurr" : "timburr"}.png`} alt="" aria-hidden="true" />}
+  </div>;
+}
diff --git a/apps/web/src/companion/Companion.tsx b/apps/web/src/companion/Companion.tsx
new file mode 100644
index 0000000..c0199d7
--- /dev/null
+++ b/apps/web/src/companion/Companion.tsx
@@ -0,0 +1,79 @@
+import { lazy, Suspense, useEffect, useState } from 'react';
+import { useLocation } from 'react-router-dom';
+import { useGameStore } from '../game/store';
+import { FOREMAN_DEMO, transitionCue, WELCOME } from './cues';
+import { useCompanion } from './state';
+import { useCompanionPreferences } from './preferences';
+import { useCompanionSound } from './useCompanionSound';
+import './companion.css';
+
+const AvatarStage = lazy(() => import('./AvatarStage').then(module => ({ default: module.AvatarStage })));
+const tips = [
+  'Touching isn’t connecting. In Shared table, each member end needs its own connection card.',
+  'A triangle is a builder’s best friend. A real brace can stop a frame from swaying.',
+  'A cable pulls; it doesn’t push. Check the solver notes before trusting cable results.',
+  'I carry timber. Foundations carry the structure. Follow the load path down to one.',
+  'An unresolved result means we don’t know yet. It isn’t a collapse—or a clean bill of health.',
+];
+
+/** Persistent across routes; game events are read-only, and no private cards are inspected. */
+export function Companion() {
+  const { pathname } = useLocation();
+  const { cue, sequence, react } = useCompanion();
+  const { preferences, update, reduced } = useCompanionPreferences();
+  const [settings, setSettings] = useState(false);
+  const [speaking, setSpeaking] = useState(true);
+  const [modelAttempt, setModelAttempt] = useState(0);
+  const [tip, setTip] = useState(0);
+  useCompanionSound(preferences.sound && !preferences.hidden, cue.mood, sequence);
+  useEffect(() => {
+    if (pathname !== '/play') { react(WELCOME); return; }
+    react({ mood: 'welcome', text: 'Hard hat? Optional. Good connections? Essential. Let’s get building!' });
+    return useGameStore.subscribe((after, before) => {
+      const next = transitionCue(before, after);
+      if (next) react(next);
+    });
+  }, [pathname, react]);
+  useEffect(() => {
+    setSpeaking(true);
+    const timeout = window.setTimeout(() => setSpeaking(false), cue.mood === 'foreman' ? 9000 : 6500);
+    return () => window.clearTimeout(timeout);
+  }, [sequence, cue.mood]);
+  // The costume and expanded presentation always settle, even without user input.
+  const dramatic = speaking && ['foreman', 'celebrate', 'repair'].includes(cue.mood);
+  const mood = speaking ? cue.mood : 'welcome';
+  if (preferences.hidden) return <button type="button" className="companion-restore" onClick={() => update({ hidden: false })} aria-label="Show Timburr companion">✦ Timburr</button>;
+  return <aside className={`companion${dramatic ? ' companion-dramatic' : ''}${reduced ? ' companion-reduced' : ''}${preferences.effects ? ' companion-effects' : ''}${pathname === '/play' ? ' companion-playing' : ''}`} aria-label="Timburr building companion" data-mood={mood}>
+    {speaking && <div className="companion-speech" role="status" aria-live="polite" aria-atomic="true">
+      <span className="companion-eyebrow">{mood === 'foreman' ? 'Conkeldurr · Foreman mode' : 'Your building buddy'}</span>
+      <p>{cue.text}</p>
+      <button type="button" className="companion-dismiss" aria-label="Dismiss companion message" onClick={() => setSpeaking(false)}>×</button>
+    </div>}
+    <button type="button" className="companion-character" aria-label={mood === 'foreman' ? 'Conkeldurr: talk to your building buddy' : 'Timburr: talk to your building buddy'} onClick={() => {
+      react({ mood: 'celebrate', text: tips[tip % tips.length] });
+      setTip(value => value + 1);
+    }}>
+      <span className="companion-halo" aria-hidden="true" />
+      <Suspense fallback={<span className="companion-model-note">Timburr is on the way…</span>}>
+        <AvatarStage key={modelAttempt} mood={mood} sequence={sequence} reduced={reduced} />
+      </Suspense>
+    </button>
+    <div className="companion-nameplate"><span><i aria-hidden="true" />{mood === 'foreman' ? 'Conkeldurr' : 'Timburr'}<small>{mood === 'foreman' ? 'Big feelings. Bigger standards.' : 'Little builder. Big ideas.'}</small></span>
+      <button type="button" aria-label="Companion settings" aria-expanded={settings} aria-controls="companion-settings" onClick={() => setSettings(value => !value)}>⚙</button>
+    </div>
+    {settings && <section id="companion-settings" className="companion-settings" aria-label="Companion settings">
+      <header><b>Meet your site buddy</b><button type="button" aria-label="Close companion settings" onClick={() => setSettings(false)}>×</button></header>
+      <p>A little help. A little mischief. Always on your side.</p>
+      <label><input type="checkbox" checked={preferences.effects} onChange={event => update({ effects: event.target.checked })} /> Glow & pulse</label>
+      <label><input type="checkbox" checked={preferences.sound} onChange={event => update({ sound: event.target.checked })} /> Companion sounds</label>
+      <label>Motion<select value={preferences.motion} onChange={event => {
+        const motion = event.target.value;
+        if (motion === 'system' || motion === 'reduced' || motion === 'full') update({ motion });
+      }}><option value="system">Follow device setting</option><option value="reduced">Reduced</option><option value="full">Full</option></select></label>
+      <button type="button" className="companion-action" onClick={() => { react(FOREMAN_DEMO); setSettings(false); }}>Preview Conkeldurr transformation</button>
+      <button type="button" className="companion-action" onClick={() => setModelAttempt(value => value + 1)}>Reload 3D model</button>
+      <button type="button" className="companion-action" onClick={() => { setSettings(false); update({ hidden: true }); }}>Hide companion</button>
+      <a href="https://sketchfab.com/nguyenlouis32" target="_blank" rel="noreferrer">3D models: nguyenlouis32 · CC BY 4.0</a>
+    </section>}
+  </aside>;
+}
diff --git a/apps/web/src/companion/companion.css b/apps/web/src/companion/companion.css
new file mode 100644
index 0000000..3661a94
--- /dev/null
+++ b/apps/web/src/companion/companion.css
@@ -0,0 +1,66 @@
+.companion {
+  --buddy-ink: #f5eada;
+  --buddy-muted: #c3b2a2;
+  --buddy-gold: #efb761;
+  position: fixed;
+  right: max(22px, env(safe-area-inset-right));
+  bottom: max(22px, env(safe-area-inset-bottom));
+  z-index: 18;
+  width: 164px;
+  color: var(--buddy-ink);
+  font: 13px/1.45 ui-rounded, 'Segoe UI', system-ui, sans-serif;
+  pointer-events: none;
+  isolation: isolate;
+}
+.companion-playing { bottom: 174px; right: 20px; }
+.companion button, .companion select, .companion input, .companion-settings, .companion-speech { pointer-events: auto; }
+.companion button, .companion-restore { font: inherit; cursor: pointer; touch-action: manipulation; }
+.companion button:focus-visible, .companion a:focus-visible, .companion select:focus-visible, .companion input:focus-visible, .companion-restore:focus-visible { outline: 3px solid #8fe2e1; outline-offset: 4px; }
+.companion-character { position: relative; display: block; width: 164px; height: 160px; padding: 0; background: none; border: 0; color: inherit; border-radius: 50%; transition: transform 220ms ease; }
+.companion-character:hover { transform: translateY(-3px); }
+.companion-stage { position: absolute; inset: -14px -8px 0; width: 180px; height: 180px; }
+.companion-stage canvas { display: block; width: 180px; height: 180px; }
+.companion-halo { position: absolute; inset: 36px 14px 0; border-radius: 50%; background: radial-gradient(ellipse, #d8a76125 0%, #c3905720 42%, transparent 72%); opacity: 0; }
+.companion-effects .companion-halo { opacity: 1; }
+.companion-effects[data-mood="foreman"] .companion-halo { background: radial-gradient(ellipse, #f3873e6b, #d55a2920 50%, transparent 73%); animation: buddy-glow 1.8s ease-in-out 3; }
+.companion-nameplate { position: relative; display: flex; justify-content: space-between; align-items: center; padding: 9px 10px 10px 14px; border: 1px solid #e5ba733b; border-radius: 14px; background: linear-gradient(130deg, #29383b, #1c242c); box-shadow: 0 6px 24px #10151f30; }
+.companion-nameplate span { font-weight: 700; letter-spacing: .02em; }
+.companion-nameplate i { display: inline-block; width: 5px; height: 5px; margin-right: 7px; border-radius: 50%; background: var(--buddy-gold); }
+.companion-nameplate small { display: block; font-size: 9px; font-weight: 400; color: var(--buddy-muted); letter-spacing: .01em; padding-top: 2px; }
+.companion-nameplate button, .companion-settings header button { border: 0; background: transparent; color: var(--buddy-muted); padding: 5px; border-radius: 7px; font-size: 19px; }
+.companion-nameplate button:hover, .companion-settings button:hover { color: #fff; background: #ffffff10; }
+.companion-speech { position: absolute; right: 138px; bottom: 74px; width: 238px; padding: 16px 24px 15px 17px; background: linear-gradient(140deg, #29383bf5, #1e252ef5); border: 1px solid #d8bd8938; border-radius: 17px 17px 4px 17px; box-shadow: 0 8px 30px #12182024; animation: buddy-arrive 220ms ease-out both; }
+.companion-eyebrow { display: block; color: var(--buddy-gold); font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; margin-bottom: 6px; }
+.companion-speech p { margin: 0; font-size: 12px; line-height: 1.6; }
+.companion-dismiss { position: absolute; top: 5px; right: 5px; padding: 3px 6px; border: 0; background: transparent; color: #b5aba0; font-size: 17px !important; }
+.companion-settings { position: absolute; bottom: 0; right: 0; width: 272px; padding: 18px; border: 1px solid #d8bd8940; border-radius: 18px; background: #222e33; box-shadow: 0 12px 40px #10151f44; }
+.companion-settings header { display: flex; align-items: center; justify-content: space-between; }
+.companion-settings header b { font-size: 14px; }
+.companion-settings p { margin: 5px 0 16px; font-size: 11px; color: var(--buddy-muted); }
+.companion-settings label { display: flex; align-items: center; gap: 8px; margin: 12px 0; font-size: 12px; }
+.companion-settings input { accent-color: var(--buddy-gold); width: 16px; height: 16px; }
+.companion-settings select { min-width: 0; width: 172px; color: var(--buddy-ink); background: #172228; border: 1px solid #d8bd8940; border-radius: 6px; padding: 5px; font: inherit; }
+.companion-action { display: block; text-align: left; width: 100%; border: 1px solid #d8bd8930; border-radius: 9px; padding: 9px 10px; background: #ffffff06; color: var(--buddy-ink); margin-top: 8px; font-size: 11px !important; }
+.companion-settings a { display: block; margin-top: 15px; color: var(--buddy-muted); font-size: 9px; }
+.companion-model-note { position: absolute; top: 75px; left: 16px; right: 16px; text-align: center; font-size: 11px; padding: 5px; border-radius: 8px; background: #223137; color: #f5eada; }
+.companion-restore { position: fixed; right: 16px; bottom: 174px; z-index: 18; border: 1px solid #d8bd8940; border-radius: 24px; background: #25343a; color: #efc78c; padding: 9px 14px; box-shadow: 0 4px 16px #10151f22; font: 12px system-ui; }
+.companion-dramatic .companion-character { transform: scale(1.17) translateY(-10px); }
+.companion[data-mood="foreman"] .companion-nameplate { border-color: #ee9a58aa; }
+@keyframes buddy-arrive { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
+@keyframes buddy-glow { 50% { opacity: .45; } }
+.companion-reduced *, .companion-reduced .companion-character:hover { animation: none !important; transition: none !important; transform: none !important; }
+@media (max-width: 700px) {
+  .companion { right: 8px; width: 120px; bottom: 12px; }
+  .companion-playing { bottom: 190px; }
+  .companion-character { width: 120px; height: 116px; }
+  .companion-stage { transform: scale(.75); transform-origin: bottom left; inset: -50px -5px 0; }
+  .companion-nameplate { padding: 6px 8px; border-radius: 11px; }
+  .companion-nameplate small { display: none; }
+  .companion-nameplate button { font-size: 17px; }
+  .companion-speech { right: 0; bottom: 158px; width: min(254px, calc(100vw - 18px)); box-sizing: border-box; }
+  .companion-settings { width: min(272px, calc(100vw - 18px)); box-sizing: border-box; }
+  .companion-dramatic .companion-character { transform: scale(1.06); }
+}
+
+
+.companion-portrait { display: block; position: absolute; inset: 0; width: 180px; height: 180px; object-fit: contain; filter: drop-shadow(0 6px 5px #14202b25); animation: buddy-arrive 240ms ease-out both; }
