+import { useEffect, useState } from 'react';
+
+export interface CompanionPreferences { hidden: boolean; effects: boolean; sound: boolean; motion: 'system' | 'reduced' | 'full' }
+const defaults: CompanionPreferences = { hidden: false, effects: true, sound: false, motion: 'system' };
+const key = 'dof-companion-v1';
+function read(): CompanionPreferences {
+  try {
+    const saved: unknown = JSON.parse(localStorage.getItem(key) ?? 'null');
+    if (typeof saved !== 'object' || saved === null) return defaults;
+    const p = saved as Record<string, unknown>;
+    return {
+      hidden: typeof p.hidden === 'boolean' ? p.hidden : defaults.hidden,
+      effects: typeof p.effects === 'boolean' ? p.effects : defaults.effects,
+      sound: typeof p.sound === 'boolean' ? p.sound : defaults.sound,
+      motion: p.motion === 'reduced' || p.motion === 'full' ? p.motion : 'system',
+    };
+  } catch { return defaults; }
+}
+
+export function useCompanionPreferences() {
+  const [preferences, setPreferences] = useState(read);
+  const [systemReduced, setSystemReduced] = useState(() => matchMedia('(prefers-reduced-motion: reduce)').matches);
+  useEffect(() => {
+    const media = matchMedia('(prefers-reduced-motion: reduce)');
+    const update = () => setSystemReduced(media.matches);
+    media.addEventListener('change', update);
+    return () => media.removeEventListener('change', update);
+  }, []);
+  const update = (patch: Partial<CompanionPreferences>) => {
+    setPreferences(current => {
+      const next = { ...current, ...patch };
+      try { localStorage.setItem(key, JSON.stringify(next)); } catch { /* Session controls work when storage is unavailable. */ }
+      return next;
+    });
+  };
+  return { preferences, update, reduced: preferences.motion === 'reduced' || (preferences.motion === 'system' && systemReduced) };
+}
